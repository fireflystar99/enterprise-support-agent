# LLM
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3

# Database
# docker-compose 中 POSTGRES_* 变量同样会被读取；本机开发用 DATABASE_URL
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=support_agent
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/support_agent

# App
APP_ENV=development
LOG_LEVEL=INFO
ADMIN_TOKEN=changeme-for-demo
USER_ID=demo
